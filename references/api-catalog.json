{
  "version": "2026-10-27",
  "origin": "https://app.trade-wind.co",
  "notes": "Request contracts independently extracted from official OpenAPI. Legacy and account routes from public command inventory; live verification is separate.",
  "operations": {
    "company.search": {
      "method": "POST",
      "path": "/api/company/search",
      "title": "（瀑布流）企业搜索",
      "sources": [
        "https://docs.trade-wind.co/442720054e0.md"
      ],
      "schemas": [
        {
          "type": "object",
          "properties": {
            "page": {
              "type": "integer",
              "description": ">=1，默认为1"
            },
            "per_page": {
              "type": "integer",
              "description": "无效或 <1 时默认 10，上限100"
            },
            "waterfall": {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "description": "first_match（第一个匹配的）或aggregate（聚合匹配），此接口默认first_match"
                },
                "source_order": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "默认hunter → rocketreach → apollo → map → ecommerce。ecommerce.enabled == true 时将把 ecommerce 提到最前；local_search.enabled == true 时若顺序里还没有 map 相关项会追加 map"
                },
                "byok": {
                  "type": "object",
                  "properties": {
                    "apollo_api_key": {
                      "type": "string"
                    },
                    "rocketreach_api_key": {
                      "type": "string"
                    },
                    "storelead_api_key": {
                      "type": "string"
                    },
                    "snov_client_id": {
                      "type": "string"
                    },
                    "snov_client_secret": {
                      "type": "string"
                    },
                    "hunter_api_key": {
                      "type": "string"
                    }
                  },
                  "description": "可使用相应数据源中您自己的api key来减少积分消耗"
                }
              }
            },
            "company": {
              "type": "object",
              "properties": {
                "names": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "没有域名时必传，与 domains 同时非空时 域名优先"
                },
                "domains": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "没有公司名时必传"
                },
                "keywords": {
                  "type": "object",
                  "properties": {
                    "include": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "description": "公司相关描述词，仅RR/Hunter/Ecommerce支持"
                }
              }
            },
            "industry": {
              "type": "object",
              "properties": {
                "include": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "description": "公司所属行业，apollo不支持此参数。"
            },
            "technologies": {
              "type": "object",
              "properties": {
                "include": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "exclude": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "仅hunter支持"
                }
              },
              "description": "例如\"salesforce\"(仅apollo/hunter/ecommerce支持，具体合法传参见”（瀑布流）获取合法technologies“接口"
            },
            "location": {
              "type": "object",
              "properties": {
                "country_code": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "一定要用ISO2格式，参考：https://countrycodebase.com/zh-hans/iso-codes/"
                },
                "cities": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "states": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "description": "公司所在地"
            },
            "size": {
              "type": "object",
              "properties": {
                "employee_ranges": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "min": {
                        "type": "integer"
                      },
                      "max": {
                        "type": "integer"
                      }
                    }
                  }
                },
                "revenue_ranges": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {}
                  },
                  "description": "仅Apollo/RR支持"
                }
              }
            },
            "funding": {
              "type": "object",
              "properties": {
                "amount_min": {
                  "type": "integer"
                },
                "amount_max": {
                  "type": "integer"
                }
              }
            },
            "similar_to": {
              "type": "boolean",
              "description": "仅hunter支持此参数，默认false"
            },
            "ecommerce": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "默认不开启"
                },
                "platforms": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "可传shopify和woocommerce"
                },
                "rank_platform": {
                  "type": "object",
                  "properties": {
                    "rank_min": {
                      "type": "integer",
                      "description": "排名绝对值"
                    },
                    "rank_max": {
                      "type": "integer",
                      "description": "排名绝对值"
                    },
                    "percentile_min": {
                      "type": "integer",
                      "description": "排名相对值"
                    },
                    "percentile_max": {
                      "type": "integer",
                      "description": "排名相对值"
                    }
                  },
                  "description": "指建站平台排名，例如shopify"
                },
                "rank_global": {
                  "type": "object",
                  "properties": {
                    "rank_min": {
                      "type": "integer",
                      "description": "排名绝对值"
                    },
                    "rank_max": {
                      "type": "integer",
                      "description": "排名绝对值"
                    },
                    "percentile_min": {
                      "type": "integer",
                      "description": "排名相对值"
                    },
                    "percentile_max": {
                      "type": "integer",
                      "description": "排名相对值"
                    }
                  },
                  "description": "指所有建站平台的综合排名"
                }
              }
            },
            "local_search": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "不传时默认为false"
                },
                "location": {
                  "type": "string",
                  "description": "通过指定GPS坐标来调整搜索区域的核心位置，格式为：@纬度,经度,缩放级别。\n例如@40.6973709,-74.1444871,11z。\n\n可以打开谷歌地图，将地图拖拽到目标位置，然后查看浏览器地址栏中的URL，即可获取相应的坐标。\n\n缩放级别虽为可选参数，但建议填写以提高搜索精度。取值范围为3z（完全缩小）到21z（完全放大）。\n通过“place_id”或“cid”查询时此参数无效。"
                },
                "language": {
                  "type": "string",
                  "description": "默认为英语"
                },
                "place_id": {
                  "type": "string",
                  "description": "Google地点ID用于唯一标识谷歌地图上的位置，适用于大多数地点（如商家、地标、公园、路口）。同一地点可能有多个不同ID，且这些ID可能随时间变化。"
                },
                "cid": {
                  "type": "string",
                  "description": "Google CID（客户标识号）是谷歌地图上特定商家页面的唯一识别编号"
                }
              }
            },
            "response": {
              "type": "object",
              "properties": {
                "include_provider_raw": {
                  "type": "boolean",
                  "description": "不传时默认为false"
                }
              }
            }
          }
        }
      ],
      "access": "data",
      "live_verified": false
    },
    "company.enrich": {
      "method": "POST",
      "path": "/api/company/enrich",
      "title": "（瀑布流）企业详情",
      "sources": [
        "https://docs.trade-wind.co/442720055e0.md"
      ],
      "schemas": [
        {
          "type": "object",
          "properties": {
            "identity": {
              "type": "object",
              "properties": {
                "domains": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "与 names 至少传一个；同时传时以 domains 为准"
                },
                "names": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "没有域名时必传"
                }
              }
            },
            "waterfall": {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "description": "first_match（第一个匹配的）或aggregate（聚合匹配），此接口默认aggregate"
                },
                "source_order": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "默认hunter → apollo → snov → rocketreach"
                },
                "byok": {
                  "type": "object",
                  "properties": {
                    "hunter_api_key": {
                      "type": "string"
                    },
                    "apollo_api_key": {
                      "type": "string"
                    },
                    "snov_client_id": {
                      "type": "string"
                    },
                    "snov_client_secret": {
                      "type": "string"
                    },
                    "rocketreach_api_key": {
                      "type": "string",
                      "description": "classic / universal 均可，该源费用减半"
                    }
                  },
                  "description": "可使用相应数据源中您自己的api key来减少积分消耗"
                }
              },
              "description": "本次请求相关规则"
            },
            "response": {
              "type": "object",
              "properties": {
                "include_provider_raw": {
                  "type": "boolean",
                  "description": "不传时默认为false"
                }
              }
            }
          },
          "required": [
            "identity"
          ]
        }
      ],
      "access": "data",
      "live_verified": false,
      "live_scope": "Hunter, one known RU domain, company record returned"
    },
