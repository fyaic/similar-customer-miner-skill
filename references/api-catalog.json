    "customs.search": {
      "method": "POST",
      "path": "/api/customs/search",
      "title": "获取海关数据列表",
      "sources": [
        "https://docs.trade-wind.co/447390392e0.md"
      ],
      "schemas": [
        {
          "type": "object",
          "properties": {
            "start_time": {
              "type": "string",
              "description": "开始日期，格式 YYYY-MM-DD，用于限定查询时间范围的起始时间。"
            },
            "end_time": {
              "type": "string",
              "description": "结束日期，格式 YYYY-MM-DD，用于限定查询时间范围的结束时间。"
            },
            "product": {
              "type": "string",
              "description": "产品关键词，用于按产品名称筛选海关数据，例如 toy。"
            },
            "hscode": {
              "type": "string",
              "description": "商品 HS 编码，用于按海关商品编码筛选。为空时表示不过滤。"
            },
            "tradeCode": {
              "type": "string",
              "description": "贸易编码或业务筛选编码，用于扩展业务条件筛选。为空时表示不过滤。"
            },
            "exporter_country": {
              "type": "string",
              "description": "出口国家编码，用于筛选出口国家。为空时表示不限。参考\n/api/customs/reference/countries"
            },
            "importer_country": {
              "type": "string",
              "description": "进口国家编码，用于筛选进口国家。为空时表示不限。参考\n/api/customs/reference/countries"
            },
            "buyer": {
              "type": "string",
              "description": "买方公司名称，用于按采购商名称筛选，通常支持模糊搜索。"
            },
            "seller": {
              "type": "string",
              "description": "卖方公司名称，用于按供应商名称筛选，通常支持模糊搜索。"
            },
